# CPU mode is the default. You do not need to set anything for CPU.
#
# Uncomment these only when you want to switch the backend to local CUDA mode.
#
# COGNITIVE_RUNTIME_PRESET=local_cuda_test
# COGNITIVE_LOCAL_REASONING_OLLAMA_TAG=phi3.5:mini-instruct-q4_K_M
#
# Optional: set the Hugging Face Space repo id so the local HF helper commands
# know which Space to operate on.
#
# HF_SPACE_REPO_ID=your-username/your-space-name
